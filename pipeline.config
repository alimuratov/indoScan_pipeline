# IndoScan pipeline configuration
# ===============================
# Edit this file and run:
#   ./run_pipeline.sh
#
# Notes:
# - Step 1 (pairing) runs ONLY if both IMAGE_DIR and PCD_DIR are set.
# - Pairing is intentionally explicit because it *cleans old pothole_* folders*
#   under SEGMENT_DIR before writing new ones.

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Segment folder (unit of work)
SEGMENT_DIR="/Users/alimuratov/Desktop/indoScan/pipeline_test/seg-002"

# Root folder for all outputs (Data2 export + final JSON live under this)
OUTPUT_ROOT="/Users/alimuratov/Desktop/indoScan/pipeline_test/output"

# -----------------------------------------------------------------------------
# OPTIONAL OVERRIDES
# -----------------------------------------------------------------------------

# Data2 export root (default: "$OUTPUT_ROOT/data2")
DATA2_DIR="$OUTPUT_ROOT/data2"

# Final consolidated JSON (default: "$DATA2_DIR/trial_output.json")
FINAL_JSON="$DATA2_DIR/trial_output.json"

# -----------------------------------------------------------------------------
# STEP 1: PAIRING (optional)
# -----------------------------------------------------------------------------

# If you want to run pairing from raw assets, set these.
# Common layout: images + PCDs are inside the segment dir:
#   IMAGE_DIR="$SEGMENT_DIR/Images"
#   PCD_DIR="$SEGMENT_DIR/PCDs"
#
# If left empty, `run_pipeline.sh` will auto-derive these paths from SEGMENT_DIR
# *when they exist*. To avoid wiping work, auto-pairing runs only when no
# pothole_* folders exist yet. Set explicitly to force re-pairing.
IMAGE_DIR=""
PCD_DIR=""

# Starting pothole id (only used for pairing)
START_ID=1

# -----------------------------------------------------------------------------
# STEP 2: ANALYSIS (paired_assets_analysis)
# -----------------------------------------------------------------------------

# DBSCAN epsilon (used only when SUMMARY_ONLY=false)
EPS=0.05

# If true: skip DBSCAN clustering and treat all filtered pothole points as one cluster.
# If false: run DBSCAN clustering (requires scikit-learn).
SUMMARY_ONLY=false

# If true: export one folder per pothole cluster (pothole_XXX_c000, ...)
EXPORT_INSTANCES=true

# -----------------------------------------------------------------------------
# STEP 3: SEGMENT PROCESSING (segment_processing)
# -----------------------------------------------------------------------------

FPS=10
IMU_INTERVAL=30.0

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

LOG_LEVEL="INFO"
